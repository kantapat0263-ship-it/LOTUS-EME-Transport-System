rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // หลักการ (2026-10-10 รัดสิทธิ์อ่าน):
    // - อ่าน: ต้องเป็นบัญชีที่ admin อนุมัติแล้ว (active == true) — ไม่ล็อกอิน/รออนุมัติ/ไม่มีโปรไฟล์ อ่านข้อมูลธุรกิจไม่ได้
    //   (dashboard layout ไม่ render หน้าลูก/เมนูจนกว่าโปรไฟล์ active จึงไม่มี listener ที่โดนปฏิเสธจนแอป throw)
    //   ข้อมูลรถ/พ.ร.บ./ภาษี/ราคาน้ำมัน = staff · ใบขอรถ/ขออนุมัติเร่งด่วน = staff หรือเจ้าของใบ
    //   ใบงานคนขับจากลิงก์ LINE อ่านผ่าน /api/driver-ticket (ตรวจ token ที่ server) — ไม่เปิด trips/drivers แบบ public แล้ว
    //   users = ตัวเองหรือ staff (บัญชีรออนุมัติอ่านโปรไฟล์ตัวเองได้ เพื่อตรวจสถานะ)
    // - เขียน: ต้องเป็นบัญชีที่ admin อนุมัติแล้ว (active == true) และ role ถึง
    //   staff = admin/dispatcher; viewer ทำได้เฉพาะงานของตัวเอง (ขอรถ/ยกเลิกใบตัวเอง/ขออนุมัติเร่งด่วน/เพิ่มสถานที่)
    // - role/active/pending ใน users แก้ได้เฉพาะ admin (เดิม user แก้ role ตัวเองเป็น admin ได้)
    // - collection ที่ไม่ระบุ = ปฏิเสธ (เดิม fallback เปิดอ่าน/เขียนทุกอย่างให้ทุกคนที่ login)

    function signedIn() {
      return request.auth != null;
    }

    // users/{uid} ของคนที่เรียก — {} ถ้ายังไม่มี doc
    function me() {
      let p = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return p == null ? {} : p.data;
    }

    // บัญชีที่ admin อนุมัติแล้ว — ด่านเดียวกับที่ (dashboard)/layout.tsx เด้งคน !active กลับหน้า login
    function isActiveUser() {
      return signedIn() && me().get('active', false) == true;
    }

    function isStaff() {
      return isActiveUser() && me().get('role', '') in ['admin', 'dispatcher'];
    }

    function isAdmin() {
      return isActiveUser() && me().get('role', '') == 'admin';
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function changesOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    match /users/{userId} {
      // ตัวเองอ่านได้เสมอ (หน้า login ต้องอ่านเพื่อเช็ก active) / list ทั้งหมดใช้แค่หน้า admin
      allow read: if isSelf(userId) || isStaff();
      // สมัครเอง = viewer ที่ยังไม่ active เท่านั้น (รอ admin เปิดสวิตช์ที่หน้าจัดการผู้ใช้)
      // ไม่มีอีเมลไหนตั้งตัวเองเป็นแอดมินได้แล้ว (เดิม isBootstrapAdmin ฝังอีเมลเจ้าของ) — กู้สิทธิ์ทำที่ Firebase Console
      allow create: if isAdmin() || (
        isSelf(userId)
        && request.resource.data.role == 'viewer'
        && request.resource.data.active == false
      );
      // แก้ของตัวเองได้แค่ชื่อ/เบอร์ (หน้า profile)
      allow update: if isAdmin() || (
        isSelf(userId) && changesOnly(['name', 'phone', 'updatedAt'])
      );
      allow delete: if isAdmin();
    }

    // เจ้าของเอกสาร (ฟิลด์ userId) — query ฝั่งผู้ขอต้องกรอง where("userId", "==", uid) เสมอ
    function isActiveOwner(data) {
      return isActiveUser() && data.get('userId', '') == request.auth.uid;
    }

    match /vehicleRequests/{requestId} {
      // ผู้ขอทั่วไปเห็นเฉพาะใบตัวเอง · การออกเลข VR (ต้องนับใบทุกคนในวัน) ย้ายไป POST /api/vehicle-requests แล้ว
      allow read: if isStaff() || isActiveOwner(resource.data);
      // ผู้ขอทั่วไปส่งใบผ่าน server เท่านั้น (ออกเลข VR ใน transaction ฝั่ง server)
      allow create: if isStaff();
      // เจ้าของทำได้อย่างเดียวคือยกเลิกใบตัวเอง (requests/page.tsx handleCancelRequest)
      allow update: if isStaff() || (
        isActiveUser()
        && resource.data.userId == request.auth.uid
        && request.resource.data.status == 'cancelled'
        && changesOnly(['status', 'cancelledAt', 'updatedAt'])
      );
      allow delete: if isStaff();
    }

    // ข้อความสั้นที่ผู้ขอแนบกับคำขอส่งใบหลังเวลาปิดรับ — ไม่มีก็ได้ (คำขอเก่า) แต่ถ้ามีต้องเป็นข้อความไม่ยาวเกิน
    function optionalText(data, key, max) {
      return !data.keys().hasAny([key]) || (data[key] is string && data[key].size() <= max);
    }

    match /urgentRequests/{urgentId} {
      allow read: if isStaff() || isActiveOwner(resource.data);
      // ความยาวตรงกับ URGENT_DETAIL_LIMITS ใน src/lib/urgentRequest.ts
      allow create: if isStaff() || (
        isActiveUser()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && optionalText(request.resource.data, 'destination', 200)
        && optionalText(request.resource.data, 'jobSummary', 500)
        && optionalText(request.resource.data, 'contactPhone', 30)
      );
      // อนุมัติ/ปฏิเสธ = คนจัดรถ
      allow update, delete: if isStaff();
    }

    // token ลิงก์ใบงานคนขับ (รุ่นต่อทริป) และรหัสการส่งใบขอรถ (กันใบซ้ำ) — server เท่านั้น
    match /driverLinks/{tripId} { allow read, write: if false; }
    match /vehicleRequestOperations/{operationId} { allow read, write: if false; }

    match /queueResourceDays/{key} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['version', 'updatedAt'])
        && request.resource.data.version == 1;
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['version', 'updatedAt'])
        && request.resource.data.version == resource.data.version + 1;
      allow delete: if false;
    }
    match /continuousBookings/{bookingId} { allow read, write: if false; }
    match /continuousQueueEvents/{eventId} { allow read, write: if false; }
    match /continuousQueueOperations/{operationId} { allow read, write: if false; }

    function queueGuardTouched(key, mustBeFree) {
      let path = /databases/$(database)/documents/queueResourceDays/$(key);
      return existsAfter(path)
        && getAfter(path).data.version == (exists(path) ? get(path).data.version + 1 : 1)
        && (!mustBeFree || getAfter(path).data.get('bookingId', '') == '');
    }
    function tripAllocationDate(data) {
      let canonical = data.get('tripDate', '');
      return canonical is string && canonical != '' ? canonical : data.get('date', '');
    }
    function tripGuardsTouched(data, mustBeFree) {
      let actual = data.get('actualDriverId', '');
      let driver = actual is string && actual != '' ? actual : data.get('driverId', '');
      let vehicle = data.get('vehicleId', '');
      let date = tripAllocationDate(data);
      return (driver == '' || queueGuardTouched('driver__' + driver + '__' + date, mustBeFree))
        && (vehicle == '' || queueGuardTouched('vehicle__' + vehicle + '__' + date, mustBeFree));
    }
    function ordinaryTrip(data) {
      return !data.keys().hasAny(['queueLink']);
    }
    function validTripAllocation(data) {
      let date = tripAllocationDate(data);
      return date is string && date.size() == 10
        && data.driverId is string && data.driverId != ''
        && data.get('vehicleId', '') is string
        && data.status in ['Planned', 'In Progress', 'Completed', 'Cancelled'];
    }

    match /trips/{tripId} {
      // หน้าประวัติ/แดชบอร์ด/ติดตามรถของผู้ขอยังใช้ trips อยู่ → บัญชีที่อนุมัติแล้วทุก role
      allow read: if isActiveUser();
      allow create: if isStaff() && ordinaryTrip(request.resource.data)
        && request.resource.data.tripDate is string && request.resource.data.tripDate.size() == 10
        && validTripAllocation(request.resource.data)
        && request.resource.data.get('vehicleId', '') != ''
        && tripGuardsTouched(request.resource.data, request.resource.data.status != 'Cancelled');
      allow update: if isStaff() && ordinaryTrip(resource.data) && ordinaryTrip(request.resource.data)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['tripDate', 'date', 'driverId', 'actualDriverId', 'vehicleId', 'status']) || (
          validTripAllocation(request.resource.data)
          && (!resource.data.keys().hasAny(['vehicleId']) || request.resource.data.get('vehicleId', '') != '')
          && tripGuardsTouched(resource.data, false)
          && tripGuardsTouched(request.resource.data, request.resource.data.status != 'Cancelled')
        ));
      allow delete: if isStaff() && ordinaryTrip(resource.data) && tripGuardsTouched(resource.data, false);

      // ไม่มีโค้ดใช้ subcollection นี้ (จุดส่งอยู่ในฟิลด์ trips.stops) — ปิดไว้
      match /stops/{stopId} {
        allow read, write: if false;
      }
      match /editLogs/{logId} {
        allow read: if isActiveUser();
        allow write: if isStaff();
      }
    }

    // ผู้ขอเห็นชื่อ/เบอร์คนขับของใบตัวเอง (หน้าคำขอ/ประวัติทริป) → บัญชีที่อนุมัติแล้วทุก role
    match /drivers/{driverId} {
      allow read: if isActiveUser();
      allow write: if isStaff();
    }

    function optionalCoordinate(value, limit) {
      return value == null || (value is number && value >= -limit && value <= limit);
    }
    // ชื่อ/ที่อยู่สถานที่แสดงในหลายหน้า (รวมหมุดแผนที่) — คุมชนิดและความยาวที่ฝั่ง rules ด้วย ไม่พึ่งแค่ฟอร์ม
    function validSiteName(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200;
    }
    function validSiteAddress(data) {
      return data.get('address', '') is string && data.get('address', '').size() <= 1000;
    }
    function validSiteTag(data) {
      return data.get('projectTypeTag', '') is string && data.get('projectTypeTag', '').size() <= 60;
    }
    function validSite(data) {
      return validSiteName(data) && validSiteAddress(data) && validSiteTag(data)
        && optionalCoordinate(data.get('latitude', null), 90)
        && optionalCoordinate(data.get('longitude', null), 180);
    }
    // แก้สถานที่: ตรวจเฉพาะฟิลด์ที่เปลี่ยน — ข้อมูลเก่าที่ไม่ตรงรูปแบบ (ก่อนมีกฎนี้) ยังแก้ฟิลด์อื่นได้
    function validSiteChanges() {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return (!changed.hasAny(['name']) || validSiteName(data))
        && (!changed.hasAny(['address']) || validSiteAddress(data))
        && (!changed.hasAny(['projectTypeTag']) || validSiteTag(data))
        && (!changed.hasAny(['latitude']) || optionalCoordinate(data.get('latitude', null), 90))
        && (!changed.hasAny(['longitude']) || optionalCoordinate(data.get('longitude', null), 180));
    }

    match /sites/{siteId} {
      allow read: if isActiveUser();
      // ผู้ขอทั่วไปเพิ่มสถานที่ผ่านฟอร์มขอรถ → POST /api/vehicle-requests (server ตรวจข้อมูลแล้วบันทึกพร้อมใบ)
      allow create: if isStaff() && validSite(request.resource.data);
      allow update: if isStaff() && validSiteChanges();
      allow delete: if isStaff();
    }

    match /vehicles/{vehicleId} {
      allow read: if isActiveUser();
      allow write: if isStaff();
    }
    match /vehicleTypes/{typeId} {
      allow read: if isActiveUser();
      allow write: if isStaff();
    }
    match /companySettings/{id} {
      allow read: if isActiveUser();
      allow write: if isStaff();
    }

    // ข้อมูลประจำรถ + พ.ร.บ./ภาษี (ราคา/เลขตัวถัง ฯลฯ) — ใช้เฉพาะเมนูยานพาหนะของ staff
    match /vehicleDetails/{vehicleId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }
    match /vehicleCompliance/{vehicleId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }
    // ประวัติ/หลักฐานใช้เอกสารใหม่ทุกครั้งเพื่อคงรายการเดิมสำหรับตรวจย้อนหลัง
    match /vehicleComplianceHistory/{id} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if false;
    }
    match /vehicleComplianceEvidence/{id} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if false;
    }

    // เขียนเฉพาะฝั่ง server (firebase-admin bypass rules): GPS tracking + ประวัติราคาน้ำมันจาก cron
    // เมนูติดตามรถเปิดให้ทุก role ที่อนุมัติแล้ว
    match /vehiclePositions/{deviceId} {
      allow read: if isActiveUser();
      allow write: if false;
    }
    match /vehiclePositionTrails/{id} {
      allow read: if isActiveUser();
      allow write: if false;
    }
    match /trackingDaily/{id} {
      allow read: if isActiveUser();
      allow write: if false;
    }
    // สถานะภายในของ cron — ไม่มีหน้าไหนอ่าน
    match /trackingMeta/{id} {
      allow read, write: if false;
    }
    match /dieselPriceHistory/{dateId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // collection อื่นที่ไม่ได้ระบุ — ปฏิเสธ
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
